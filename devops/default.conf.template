# default.conf.template — sirve el SPA de Angular y hace de proxy al backend.
# ${BACKEND_URL} lo reemplaza envsubst al arrancar el contenedor (ver Dockerfile).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS interno de Docker: permite resolver el backend en runtime cuando
    # proxy_pass usa una variable (evita que nginx falle al arrancar si el
    # backend aún no está listo).
    resolver 127.0.0.11 valid=30s;

    # Compresión para acelerar la descarga del bundle.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Cache agresivo para assets con hash en el nombre (outputHashing: all).
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Proxy al backend: /api/... -> BACKEND_URL/api/...
    #
    # El prefijo /api SE CONSERVA: todos los endpoints de Spring lo llevan
    # (@RequestMapping("/api/usuarios"), etc.). Quitarlo aquí haría que cada
    # petición llegara al backend como /usuarios y respondiera 404.
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fallback SPA: cualquier ruta desconocida devuelve index.html para que
    # el router de Angular maneje el enrutado del lado del cliente.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
